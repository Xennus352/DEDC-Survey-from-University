# App running on the host, connecting to the existing local `dedc` database.
# Set a dedicated database account and password before using this in production.
DATABASE_URL=mysql+pymysql://dedc:dedc@127.0.0.1:3306/dedc
# Must match the administrator role in the existing userrole table.
ADMIN_ROLE_NAME=Admin
# Create the first account in DEDC: uv run python -m app.portal_auth
# Set true when serving over HTTPS in production; false for local HTTP.
PORTAL_COOKIE_SECURE=false
# Keep this directory private and back it up together with the SQL database.
PRIVATE_STORAGE_DIR=private/dedc
# Fail quickly instead of hanging when MySQL/MariaDB is stopped or unresponsive.
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_TIMEOUT=5
DATABASE_READ_TIMEOUT=5
DATABASE_WRITE_TIMEOUT=5
# Set to private only after the verified metadata cutover; keep sql before it.
METADATA_STORAGE=sql
